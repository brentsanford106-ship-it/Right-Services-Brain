// Right Services Photos: everything the app needs in Azure, in one resource group, in a US region.
//
// Deployed by infra/go-live.sh (run by a person, in Azure Cloud Shell). Nothing in this repository creates
// Azure resources by itself. Expected cost at our size: roughly $30-40 a month (see docs/HOSTING.md).
//
// Security choices:
// - No storage keys or connection strings: the API signs in to Blob storage with its own managed identity,
//   and shared-key access is switched off on the storage account.
// - Passwords live only in Key Vault; App Service reads them through Key Vault references.
// - Photos container is private. No public blobs, no share links.
// - HTTPS only, TLS 1.2+, FTP off.

targetScope = 'resourceGroup'

@description('US region for everything. East US 2 has every service we use, including the free website tier.')
param location string = 'eastus2'

@description('Short lowercase name used in every resource name, e.g. "rsbphotos".')
@minLength(3)
@maxLength(12)
param prefix string = 'rsbphotos'

@description('Who gets the spending alert emails.')
param alertEmails array

@description('Monthly spending alert, in US dollars. You get emails at 50%, 80% and 100% (and when Azure forecasts going over).')
param monthlyBudget int = 50

@description('First day of the current month, for the budget. Leave as is.')
param budgetStart string = utcNow('yyyy-MM-01')

@secure()
@description('Database administrator password. Generated by go-live.sh and stored in Key Vault; never typed by a person.')
param postgresAdminPassword string

@description('Object ID of the person running the deployment, so they can store the generated passwords in Key Vault.')
param deployerObjectId string

@description('Microsoft sign-in (Entra External ID). Leave empty until the Entra setup is done; the API refuses to start without them.')
param oidcIssuer string = ''
param oidcAudience string = ''
param oidcJwksUri string = ''

var suffix = uniqueString(resourceGroup().id)
var names = {
  vault: '${prefix}-kv-${take(suffix, 6)}'
  storage: '${prefix}${take(suffix, 8)}'
  postgres: '${prefix}-db-${take(suffix, 6)}'
  plan: '${prefix}-plan'
  api: '${prefix}-api-${take(suffix, 6)}'
  web: '${prefix}-web'
}
var roles = {
  blobDataContributor: 'ba92f5b4-2d11-453d-a403-e96b0029c9fe'
  keyVaultSecretsUser: '4633458b-17de-408a-b874-0445c86b69e6'
  keyVaultSecretsOfficer: 'b86a8fe4-44ce-4948-aee5-eccb2c155cd7'
}

// ---------------------------------------------------------------- Key Vault (passwords)
resource vault 'Microsoft.KeyVault/vaults@2023-07-01' = {
  name: names.vault
  location: location
  properties: {
    tenantId: subscription().tenantId
    sku: { family: 'A', name: 'standard' }
    enableRbacAuthorization: true
    enableSoftDelete: true
    softDeleteRetentionInDays: 90
    enablePurgeProtection: true
    publicNetworkAccess: 'Enabled'
  }
}

resource deployerCanWriteSecrets 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  name: guid(vault.id, deployerObjectId, roles.keyVaultSecretsOfficer)
  scope: vault
  properties: {
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', roles.keyVaultSecretsOfficer)
    principalId: deployerObjectId
  }
}

// ---------------------------------------------------------------- Photo storage
resource storage 'Microsoft.Storage/storageAccounts@2023-05-01' = {
  name: names.storage
  location: location
  kind: 'StorageV2'
  sku: { name: 'Standard_ZRS' } // three copies in three separate buildings in the region
  properties: {
    accessTier: 'Hot'
    allowBlobPublicAccess: false
    allowSharedKeyAccess: false // only Azure identities, no keys
    minimumTlsVersion: 'TLS1_2'
    supportsHttpsTrafficOnly: true
    defaultToOAuthAuthentication: true
  }
}

resource blobService 'Microsoft.Storage/storageAccounts/blobServices@2023-05-01' = {
  parent: storage
  name: 'default'
  properties: {
    // Backups for photos: a deleted or overwritten photo can be recovered for 30 days.
    deleteRetentionPolicy: { enabled: true, days: 30 }
    containerDeleteRetentionPolicy: { enabled: true, days: 30 }
    isVersioningEnabled: true
  }
}

resource photos 'Microsoft.Storage/storageAccounts/blobServices/containers@2023-05-01' = {
  parent: blobService
  name: 'photos'
  properties: { publicAccess: 'None' }
}

// ---------------------------------------------------------------- Database
resource postgres 'Microsoft.DBforPostgreSQL/flexibleServers@2024-08-01' = {
  name: names.postgres
  location: location
  sku: { name: 'Standard_B1ms', tier: 'Burstable' }
  properties: {
    version: '16'
    administratorLogin: 'rsbadmin'
    administratorLoginPassword: postgresAdminPassword
    storage: { storageSizeGB: 32, autoGrow: 'Enabled' }
    // Automatic daily backups with point-in-time restore to any minute in the last 14 days.
    backup: { backupRetentionDays: 14, geoRedundantBackup: 'Disabled' }
    highAvailability: { mode: 'Disabled' }
    authConfig: { passwordAuth: 'Enabled', activeDirectoryAuth: 'Disabled' }
  }
}

resource postgresExtensions 'Microsoft.DBforPostgreSQL/flexibleServers/configurations@2024-08-01' = {
  parent: postgres
  name: 'azure.extensions'
  properties: { value: 'PGCRYPTO,CITEXT', source: 'user-override' }
}

resource database 'Microsoft.DBforPostgreSQL/flexibleServers/databases@2024-08-01' = {
  parent: postgres
  name: 'rsb'
  properties: { charset: 'UTF8', collation: 'en_US.utf8' }
  dependsOn: [postgresExtensions]
}

// Lets the API (App Service) reach the database. Connections still need the password and TLS.
// Known limit: this rule admits any Azure address; a private network would close it but costs more.
resource allowAzure 'Microsoft.DBforPostgreSQL/flexibleServers/firewallRules@2024-08-01' = {
  parent: postgres
  name: 'AllowAzureServices'
  properties: { startIpAddress: '0.0.0.0', endIpAddress: '0.0.0.0' }
}

// ---------------------------------------------------------------- Website (free tier)
resource web 'Microsoft.Web/staticSites@2023-12-01' = {
  name: names.web
  location: location
  sku: { name: 'Free', tier: 'Free' }
  properties: {}
}

// ---------------------------------------------------------------- API server
resource plan 'Microsoft.Web/serverfarms@2023-12-01' = {
  name: names.plan
  location: location
  kind: 'linux'
  sku: { name: 'B1', tier: 'Basic' }
  properties: { reserved: true }
}

var databaseUrlRef = '@Microsoft.KeyVault(VaultName=${names.vault};SecretName=database-url)'

resource api 'Microsoft.Web/sites@2023-12-01' = {
  name: names.api
  location: location
  kind: 'app,linux'
  identity: { type: 'SystemAssigned' }
  properties: {
    serverFarmId: plan.id
    httpsOnly: true
    clientAffinityEnabled: false
    siteConfig: {
      linuxFxVersion: 'NODE|22-lts'
      appCommandLine: 'node server.mjs'
      alwaysOn: true
      ftpsState: 'Disabled'
      minTlsVersion: '1.2'
      http20Enabled: true
      healthCheckPath: '/health/ready'
      appSettings: [
        { name: 'APP_ENV', value: 'production' }
        { name: 'API_HOST', value: '0.0.0.0' }
        { name: 'API_PORT', value: '8080' }
        { name: 'WEBSITES_PORT', value: '8080' }
        { name: 'SCM_DO_BUILD_DURING_DEPLOYMENT', value: 'true' }
        { name: 'DATABASE_URL', value: databaseUrlRef }
        { name: 'CORS_ALLOWED_ORIGINS', value: 'https://${web.properties.defaultHostname}' }
        { name: 'DEV_AUTH_ENABLED', value: 'false' }
        { name: 'STORAGE_DRIVER', value: 'azure_blob' }
        { name: 'AZURE_STORAGE_ACCOUNT_URL', value: storage.properties.primaryEndpoints.blob }
        { name: 'AZURE_STORAGE_CONTAINER', value: photos.name }
        { name: 'OIDC_ISSUER', value: oidcIssuer }
        { name: 'OIDC_AUDIENCE', value: oidcAudience }
        { name: 'OIDC_JWKS_URI', value: oidcJwksUri }
        { name: 'LOG_LEVEL', value: 'info' }
      ]
    }
  }
}

resource apiCanUseBlobs 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  name: guid(storage.id, api.id, roles.blobDataContributor)
  scope: storage
  properties: {
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', roles.blobDataContributor)
    principalId: api.identity.principalId
    principalType: 'ServicePrincipal'
  }
}

resource apiCanReadSecrets 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  name: guid(vault.id, api.id, roles.keyVaultSecretsUser)
  scope: vault
  properties: {
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', roles.keyVaultSecretsUser)
    principalId: api.identity.principalId
    principalType: 'ServicePrincipal'
  }
}

// ---------------------------------------------------------------- Spending alert
resource budget 'Microsoft.Consumption/budgets@2023-11-01' = {
  name: '${prefix}-monthly'
  properties: {
    category: 'Cost'
    amount: monthlyBudget
    timeGrain: 'Monthly'
    timePeriod: { startDate: budgetStart }
    notifications: {
      actual50: { enabled: true, operator: 'GreaterThanOrEqualTo', threshold: 50, thresholdType: 'Actual', contactEmails: alertEmails }
      actual80: { enabled: true, operator: 'GreaterThanOrEqualTo', threshold: 80, thresholdType: 'Actual', contactEmails: alertEmails }
      actual100: { enabled: true, operator: 'GreaterThanOrEqualTo', threshold: 100, thresholdType: 'Actual', contactEmails: alertEmails }
      forecast100: { enabled: true, operator: 'GreaterThanOrEqualTo', threshold: 100, thresholdType: 'Forecasted', contactEmails: alertEmails }
    }
  }
}

output vaultName string = vault.name
output postgresHost string = postgres.properties.fullyQualifiedDomainName
output postgresName string = postgres.name
output apiName string = api.name
output apiUrl string = 'https://${api.properties.defaultHostName}'
output websiteName string = web.name
output websiteUrl string = 'https://${web.properties.defaultHostname}'
output storageAccount string = storage.name
