# ---------------------------------------------------------------------------
# Right Services Brain — example environment file.
# Copy to `.env` for LOCAL DEVELOPMENT ONLY. Never commit `.env`.
# Staging/production secrets live in Azure Key Vault, never in files.
# All values below are placeholders; replace passwords with your own random strings.
# ---------------------------------------------------------------------------

# Environment: development | test | staging | production
APP_ENV=development

# --- Local PostgreSQL (docker compose) ---
POSTGRES_ADMIN_USER=rsb_admin
POSTGRES_ADMIN_PASSWORD=change-me-local-admin-password
POSTGRES_DB=rsb_dev

# Admin/owner connection: used ONLY by migrations and seed scripts.
DATABASE_ADMIN_URL=postgres://rsb_admin:change-me-local-admin-password@127.0.0.1:5432/rsb_dev

# Restricted runtime login used by the API (no superuser, no BYPASSRLS, not table owner).
# `pnpm db:migrate` creates/updates this login with the password below.
APP_DB_USER=rsb_app_login
APP_DB_PASSWORD=change-me-local-app-password
DATABASE_URL=postgres://rsb_app_login:change-me-local-app-password@127.0.0.1:5432/rsb_dev

# --- API ---
# Use 0.0.0.0 only while testing with a phone on your Wi-Fi; set back to 127.0.0.1 afterwards.
API_HOST=127.0.0.1
API_PORT=4000
# Comma-separated list of allowed browser origins for the web dashboard.
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# --- Development-only authentication ---
# INSECURE BY DESIGN. Only honoured when APP_ENV=development or APP_ENV=test.
# The API refuses to start if this is true in staging or production.
DEV_AUTH_ENABLED=true

# --- Production identity provider: Microsoft Entra External ID (Phase 2) ---
# Leave blank in development. Values come from the Entra app registration.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=

# --- Clients ---
# Web dashboard (Vite exposes only VITE_* variables to the browser — never put secrets here)
VITE_API_BASE_URL=http://localhost:4000
# Mobile app (Expo exposes only EXPO_PUBLIC_* variables to the app — never put secrets here)
# Use your PC's LAN IP so a phone on the same Wi-Fi can reach the API.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:4000

# Phase 2 modules (receipts, vehicles, member admin). Keep false in Phase 1.
PHASE2_FEATURES=false
